<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin require-restart="false">
    <id>mockitools</id>
    <name>Mockitools</name>
    <vendor url="https://github.com/picimako/mockitools">Tamás Balog</vendor>
    <resource-bundle>messages.MockitoolsBundle</resource-bundle>

    <!-- please see https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html on how to target different products -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Inspections for Mockito end-users -->
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.stubbing.InconsistentArgumentMatcherUsageInspection"
                id="mockitools.inconsistentArgumentMatcherUsage"
                displayName="Inconsistent argument matcher usage"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="ERROR"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.verification.VerificationModeValuesBetweenLimitsInspection"
                id="mockitools.verificationModeValuesBetweenLimits"
                displayName="Verification mode values are out of bounds"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="ERROR"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.captor.CaptorFieldInitializationInspection"
                id="mockitools.captorFieldInitialization"
                displayName="@Captor field is explicitly initialized"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="WARNING"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.captor.CaptorFieldOfTypeArgumentCaptorInspection"
                id="mockitools.captorFieldOfTypeArgumentCaptor"
                displayName="@Captor field is not of the type ArgumentCaptor"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="ERROR"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.verification.TimesVerificationModeInspection"
                id="mockitools.timesVerificationMode"
                displayName="Mockito.times() argument validations"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="WARNING"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.stubbing.ExtraInterfacesInspection"
                id="mockitools.extraInterfaces"
                displayName="@Mock#extraInterfaces and MockSettings.extraInterfaces() validations"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="ERROR"/>
        <!-- Disabled due to https://github.com/picimako/mockitools/issues/69 -->
        <!--        <localInspection-->
        <!--                implementationClass="com.picimako.mockitools.inspection.mocking.MockFieldInitializationInspection"-->
        <!--                id="mockitools.mockFieldInitialization"-->
        <!--                displayName="@Mock or @InjectMocks field is explicitly initialized"-->
        <!--                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="WARNING"/>-->
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.mocking.MockTypeInspection"
                id="mockitools.mockType"
                displayName="Mocking/spying non-mockable types"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="ERROR"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.CallOnMockitoResetInspection"
                id="mockitools.callOnMockitoReset"
                displayName="Call on Mockito.reset()"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="WARNING"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.stubbing.NoMethodCallArgumentSpecifiedInspection"
                id="mockitools.noMethodCallArgument"
                displayName="No Mockito method call argument specified"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="ERROR"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.stubbing.ThrowsCheckedExceptionStubbingInspection"
                id="mockitools.methodSignatureBasedThrowsExceptionStubbing"
                displayName="Checked exception stubbing based on method throws clause"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="ERROR"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.consecutive.SimplifyConsecutiveReturnCallsInspection"
                id="mockitools.simplifyConsecutiveReturnStubbingCalls"
                displayName="Consecutive *Return() stubbing calls can be simplified"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="WARNING"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.consecutive.SimplifyConsecutiveThrowCallsInspection"
                id="mockitools.simplifyConsecutiveThrowStubbingCalls"
                displayName="Consecutive *Throw() stubbing calls can be simplified"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="WARNING"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.stubbing.CannotStubMethodInspection"
                id="mockitools.cannotStubMethod"
                displayName="Stubbing of private/native/equals()/hashCode methods"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="ERROR"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.stubbing.EnforceConventionInspection"
                id="mockitools.enforce.convention"
                displayName="Enforce conventions"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="false" level="ERROR"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.verification.SingleInOrderVerificationInspection"
                id="mockitools.single.inorder.reference"
                displayName="InOrder variable is used only once"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="WARNING"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.verification.UnusedOrUnconfiguredMockInInOrderVerificationInspection"
                id="mockitools.unused.inorder.mock"
                displayName="Unused or unconfigured mock objects in InOrder verifications"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="WARNING"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.stubbing.StubbingAndMethodReturnTypeMismatchInspection"
                id="mockitools.stubbing.method.return.type.mismatch"
                displayName="Stubbing call's and stubbed method's return type don't match"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="ERROR"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.verification.CannotVerifyToStringInspection"
                id="mockitools.cannot.verify.to.string"
                displayName="'toString()' call in verification"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="ERROR"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.verification.StubOnlyMockInVerificationInspection"
                id="mockitools.stub.only.mock.in.verification"
                displayName="Stub-only mock used in verification"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="ERROR"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.mocking.SpyOnMockInspection"
                id="mockitools.spy.on.mock"
                displayName="Spying on mock objects"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="ERROR"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.mocking.GenericInferredMockAndSpyCreationInspection"
                id="mockitools.arg.in.generic.inferred.mock.spy.creation"
                displayName="Argument in generic inferred mock()/spy() creation"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="ERROR"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.captor.GenericInferredCaptorCreationInspection"
                id="mockitools.arg.in.generic.inferred.captor.creation"
                displayName="Argument in generic inferred ArgumentCaptor creation"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="ERROR"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.mocking.MockSpiedInstanceTypeMismatchInspection"
                id="mockitools.mock.spied.instance.type.mismatch"
                displayName="Mocked type and spied instance type mismatch"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="ERROR"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.mocking.SimplifyMockCreationInspection"
                id="mockitools.simplify.mock.creation"
                displayName="Simplify mock creation"
                language="JAVA" groupPath="Java" groupName="Mockito" enabledByDefault="true" level="INFO"/>

        <!-- v4 migration aids -->
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.migrationaids.v4.ArgumentMatchersCalledViaMatchersInspection"
                id="mockitools.aid.v4.useArgumentMatchers"
                displayName="Argument matchers are used via Matchers"
                language="JAVA" groupPath="Java,Mockito" groupName="Migration aids (v4)" enabledByDefault="false" level="WARNING"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.migrationaids.v4.UsageOfAnyMatchersInspection"
                id="mockitools.aid.v4.useAny"
                displayName="Using deprecated anyX() matcher"
                language="JAVA" groupPath="Java,Mockito" groupName="Migration aids (v4)" enabledByDefault="false" level="WARNING"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.migrationaids.v4.ParameterizedIsNotNullMatcherInspection"
                id="mockitools.aid.v4.use.non.param.null"
                displayName="Using parameterized null matcher"
                language="JAVA" groupPath="Java,Mockito" groupName="Migration aids (v4)" enabledByDefault="false" level="WARNING"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.migrationaids.v4.UsageOfDeprecatedVerifyInspection"
                id="mockitools.aid.v4.mocked.static.verify"
                displayName="Using deprecated Mockito and MockedStatic.verify"
                language="JAVA" groupPath="Java,Mockito" groupName="Migration aids (v4)" enabledByDefault="false" level="WARNING"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.migrationaids.v4.UsageOfDeprecatedPluginClassesInspection"
                id="mockitools.aid.v4.plugin.classes"
                displayName="Using deprecated plugins classes"
                language="JAVA" groupPath="Java,Mockito" groupName="Migration aids (v4)" enabledByDefault="false" level="WARNING"/>
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.migrationaids.v4.UsageOfOldJUnitRunnerInspection"
                id="mockitools.aid.v4.junit.runners"
                displayName="Using deprecated JUnit runner"
                language="JAVA" groupPath="Java,Mockito" groupName="Migration aids (v4)" enabledByDefault="false" level="WARNING"/>

        <!-- Inspections for Mockito framework integration -->
        <localInspection
                implementationClass="com.picimako.mockitools.inspection.framework.NotExtensibleClassInspection"
                id="mockitools.framework.notExtensibleClass"
                displayName="Class extends @NotExtensible class"
                language="JAVA" groupPath="Java,Mockito" groupName="Framework" enabledByDefault="false" level="WARNING"/>

        <!-- Convert/expand mocking -->
        <intentionAction>
            <language>JAVA</language>
            <categoryKey>mockito.intention.category</categoryKey>
            <className>com.picimako.mockitools.intention.mocking.ExpandMockCreationIntention</className>
        </intentionAction>

        <!-- Convert @Mock/@Spy fields to mock()/spy() calls and vice versa. -->
        <intentionAction>
            <language>JAVA</language>
            <categoryKey>mockito.intention.category</categoryKey>
            <className>com.picimako.mockitools.intention.ConvertMockSpyFieldToCallIntention</className>
        </intentionAction>
        <intentionAction>
            <language>JAVA</language>
            <categoryKey>mockito.intention.category</categoryKey>
            <className>com.picimako.mockitools.intention.ConvertSpyCallToFieldIntention</className>
        </intentionAction>
        <intentionAction>
            <language>JAVA</language>
            <categoryKey>mockito.intention.category</categoryKey>
            <className>com.picimako.mockitools.intention.ConvertMockCallToFieldIntention</className>
        </intentionAction>

        <!-- Convert arguments -->
        <intentionAction>
            <language>JAVA</language>
            <categoryKey>mockito.intention.category</categoryKey>
            <className>com.picimako.mockitools.intention.ConvertThrowStubbingArgumentsIntention</className>
        </intentionAction>

        <!-- Convert stubbing approaches -->
        <intentionAction>
            <language>JAVA</language>
            <categoryKey>mockito.intention.category</categoryKey>
            <className>com.picimako.mockitools.intention.convert.stub.ConvertFromMockitoDoIntention
            </className>
        </intentionAction>
        <intentionAction>
            <language>JAVA</language>
            <categoryKey>mockito.intention.category</categoryKey>
            <className>
                com.picimako.mockitools.intention.convert.stub.ConvertFromBDDMockitoGivenIntention
            </className>
        </intentionAction>
        <intentionAction>
            <language>JAVA</language>
            <categoryKey>mockito.intention.category</categoryKey>
            <className>
                com.picimako.mockitools.intention.convert.stub.ConvertFromBDDMockitoWillIntention
            </className>
        </intentionAction>
        <intentionAction>
            <language>JAVA</language>
            <categoryKey>mockito.intention.category</categoryKey>
            <className>com.picimako.mockitools.intention.convert.stub.ConvertFromMockitoWhenIntention
            </className>
        </intentionAction>

        <!-- Convert verification approaches -->
        <intentionAction>
            <language>JAVA</language>
            <categoryKey>mockito.intention.category</categoryKey>
            <className>
                com.picimako.mockitools.intention.convert.verification.mockitoverify.ConvertFromMockitoVerifyIntention
            </className>
        </intentionAction>
        <intentionAction>
            <language>JAVA</language>
            <categoryKey>mockito.intention.category</categoryKey>
            <className>
                com.picimako.mockitools.intention.convert.verification.bddmockitothen.ConvertFromBDDMockitoThenIntention
            </className>
        </intentionAction>
        <intentionAction>
            <language>JAVA</language>
            <categoryKey>mockito.intention.category</categoryKey>
            <className>
                com.picimako.mockitools.intention.convert.verification.inorderverify.ConvertFromInOrderVerifyIntention
            </className>
        </intentionAction>
        <intentionAction>
            <language>JAVA</language>
            <categoryKey>mockito.intention.category</categoryKey>
            <className>
                com.picimako.mockitools.intention.convert.verification.mockedstaticverify.ConvertFromMockedStaticVerifyIntention
            </className>
        </intentionAction>

        <completion.contributor language="JAVA"
                                implementationClass="com.picimako.mockitools.completion.MockCompletionContributor"/>
    </extensions>
</idea-plugin>
